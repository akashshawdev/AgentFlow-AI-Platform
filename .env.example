# AgentFlow - Environment Variables
# Copy to .env and fill in values before running

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Weaviate ──────────────────────────────────────────────────────────────────
# Local Docker (default)
WEAVIATE_URL=http://localhost:8080

# Weaviate Cloud (uncomment and fill)
# WEAVIATE_URL=https://your-cluster.weaviate.network
# WEAVIATE_API_KEY=your-weaviate-api-key

# ── Model configuration ───────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── RAG tuning ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=8
HYBRID_ALPHA=0.75
HNSW_EF=128
HNSW_EF_CONSTRUCTION=256
HNSW_MAX_CONNECTIONS=64

# ── Evaluation ────────────────────────────────────────────────────────────────
SELFCHECK_NUM_SAMPLES=5

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentflow.db
